        "for u in G.nodes():\n",
        "    k_u = G.degree[u]\n",
        "    if k_u == 0:\n",
        "        participation_coefficients[u] = 0.0  # Assign 0 for isolated nodes\n",
        "        continue\n",
        "\n",
        "    # Determine the community ID of node u\n",
        "    comm_u = node_to_community_map.get(u)\n",
        "    if comm_u is None: # Node not in any detected community\n",
        "        participation_coefficients[u] = 0.0 # Or np.nan, depending on desired handling\n",
        "        continue\n",
        "\n",
        "    k_us_counts = {}\n",
        "    for v in G.neighbors(u):\n",
        "        comm_v = node_to_community_map.get(v)\n",
        "        if comm_v is not None:\n",
        "            k_us_counts[comm_v] = k_us_counts.get(comm_v, 0) + 1\n",
        "\n",
        "    sum_squared_ratios = sum([(k_us_counts.get(s_id, 0) / k_u)**2 for s_id in range(len(communities_lp))])\n",
        "    participation_coefficients[u] = 1 - sum_squared_ratios\n",
        "\n",
        "print(\"Participation coefficients calculated.\")\n",
        "\n",
        "# 4. Calculate Within-module z-score (zᵢ) for each node\n",
        "community_internal_degrees = {comm_id: [] for comm_id in range(len(communities_lp))}\n",
        "internal_degree_for_node = {}\n",
        "\n",
        "# First pass: Calculate internal degrees for all nodes and populate community_internal_degrees\n",
        "for comm_id, community_set in enumerate(communities_lp):\n",
        "    for u in community_set:\n",
        "        k_uc = 0\n",
        "        for v in G.neighbors(u):\n",
        "            if v in community_set:\n",
        "                k_uc += 1\n",
        "        internal_degree_for_node[u] = k_uc\n",
        "        community_internal_degrees[comm_id].append(k_uc)\n",
        "\n",
        "# Second pass: Calculate z-scores using the collected internal degrees\n",
        "for comm_id, community_set in enumerate(communities_lp):\n",
        "    internal_degrees_in_c = np.array(community_internal_degrees[comm_id])\n",
        "\n",
        "    if len(internal_degrees_in_c) == 0:\n",
        "        # No nodes in this community (should not happen if communities_lp is well-formed)\n",
        "        continue\n",
        "\n",
        "    mean_k_c = np.mean(internal_degrees_in_c)\n",
        "    std_k_c = np.std(internal_degrees_in_c)\n",
        "\n",
        "    for u in community_set:\n",
        "        k_uc = internal_degree_for_node[u]\n",
        "        if std_k_c == 0:\n",
        "            # If std is 0, all nodes in the community have the same internal degree\n",
        "            # or it's a single-node community. z-score is 0.\n",
        "            z_scores[u] = 0.0\n",
        "        else:\n",
        "            z_scores[u] = (k_uc - mean_k_c) / std_k_c\n",
        "\n",
        "print(\"Z-scores calculated.\")\n",
        "\n",
        "# Display a few examples\n",
        "print(\"\\n--- Sample Participation Coefficients (P_i) ---\")\n",
        "for i, (node, p_val) in enumerate(participation_coefficients.items()):\n",
        "    if i >= 5: break\n",
        "    print(f\"Node {node}: {p_val:.4f}\")\n",
        "\n",
        "print(\"\\n--- Sample Within-module Z-scores (z_i) ---\")\n",
        "for i, (node, z_val) in enumerate(z_scores.items()):\n",
        "    if i >= 5: break\n",
        "    print(f\"Node {node}: {z_val:.4f}\")"
