      "source": [
        "# Install python-louvain if not already installed (force reinstallation to resolve import issues)\n",
        "!pip install python-louvain --force-reinstall\n",
        "\n",
        "# Attempting a more specific import path for best_partition to workaround persistent ImportError\n",
        "try:\n",
        "    from community import best_partition\n",
        "except ImportError:\n",
        "    # If the direct import fails, try importing from a common internal module path\n",
        "    # This is a workaround for environments where __init__.py might not re-export correctly.\n",
        "    try:\n",
        "        import community.community_louvain\n",
        "        best_partition = community.community_louvain.best_partition\n",
        "    except (ImportError, AttributeError) as e:\n",
        "        raise ImportError(f\"Could not import best_partition from 'community' or 'community.community_louvain'. Error: {e}\")\n",
        "\n",
        "# Define a range of resolution parameters to test\n",
        "resolutions = np.arange(0.1, 2.0, 0.1) # From 0.1 to 1.9, step 0.1\n",
        "\n",
        "num_communities_list = []\n",
        "modularity_list = []\n",
        "\n",
        "print(\"Varying Louvain resolution parameter...\")\n",
        "for res in resolutions:\n",
        "    # Use best_partition for the Louvain algorithm\n",
        "    # The partition is a dictionary where keys are nodes and values are community IDs\n",
        "    partition = best_partition(G, resolution=res, random_state=random.randint(0, 100000))\n",
        "\n",
        "    # Convert partition dictionary to a list of sets for modularity calculation\n",
        "    communities_louvain_at_res = {}\n",
        "    for node, comm_id in partition.items():\n",
        "        communities_louvain_at_res.setdefault(comm_id, set()).add(node)\n",
        "    communities_louvain_at_res = list(communities_louvain_at_res.values())\n",
        "\n",
        "    # Calculate number of communities\n",
        "    num_comm = len(communities_louvain_at_res)\n",
        "    num_communities_list.append(num_comm)\n",
        "\n",
        "    # Calculate modularity\n",
        "    mod = nx.algorithms.community.modularity(G, communities_louvain_at_res)\n",
        "    modularity_list.append(mod)\n",
        "    print(f\"  Resolution: {res:.1f}, Communities: {num_comm}, Modularity: {mod:.4f}\")\n",
        "\n",
        "# Plotting the results\n",
        "plt.figure(figsize=(14, 6))\n",
        "\n",
        "plt.subplot(1, 2, 1) # First subplot for Number of Communities\n",
        "plt.plot(resolutions, num_communities_list, marker='o', linestyle='-')\n",
        "plt.title('Number of Communities vs. Resolution Parameter (Louvain)')\n",
        "plt.xlabel('Resolution Parameter')\n",
        "plt.ylabel('Number of Communities')\n",
        "plt.grid(True)\n",
        "\n",
        "plt.subplot(1, 2, 2) # Second subplot for Modularity\n",
        "plt.plot(resolutions, modularity_list, marker='o', linestyle='-', color='orange')\n",
        "plt.title('Modularity vs. Resolution Parameter (Louvain)')\n",
        "plt.xlabel('Resolution Parameter')\n",
        "plt.ylabel('Modularity')\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
