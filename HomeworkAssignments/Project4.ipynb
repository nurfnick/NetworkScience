        "id": "4afe438d",
        "outputId": "b37c9d67-dd63-48cc-cbab-6f65d5fd72fe"
      },
      "source": [
        "num_nodes_sbm = G_sbm.number_of_nodes()\n",
        "\n",
        "# Convert ground truth communities to labels\n",
        "labels_ground_truth = communities_to_labels(ground_truth_communities, num_nodes_sbm)\n",
        "\n",
        "# Convert Label Propagation communities to labels\n",
        "labels_lp_sbm = communities_to_labels(communities_lp_sbm, num_nodes_sbm)\n",
        "\n",
        "# Convert Louvain communities to labels\n",
        "labels_louvain_sbm = communities_to_labels(communities_louvain_sbm, num_nodes_sbm)\n",
        "\n",
        "# Calculate NMI and ARI for Label Propagation\n",
        "nmi_lp = normalized_mutual_info_score(labels_ground_truth, labels_lp_sbm)\n",
        "ari_lp = adjusted_rand_score(labels_ground_truth, labels_lp_sbm)\n",
        "\n",
        "# Calculate NMI and ARI for Louvain\n",
        "nmi_louvain = normalized_mutual_info_score(labels_ground_truth, labels_louvain_sbm)\n",
        "ari_louvain = adjusted_rand_score(labels_ground_truth, labels_louvain_sbm)\n",
        "\n",
        "print(\"\\n--- Community Detection Evaluation on SBM ---\")\n",
        "print(f\"Label Propagation NMI: {nmi_lp:.4f}\")\n",
        "print(f\"Label Propagation ARI: {ari_lp:.4f}\")\n",
        "print(f\"Louvain NMI: {nmi_louvain:.4f}\")\n",
        "print(f\"Louvain ARI: {ari_louvain:.4f}\")"
      ],
