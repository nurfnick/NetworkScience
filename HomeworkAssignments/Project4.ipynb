        "outputId": "cc949300-c4a3-424c-95f6-ffb0ef806937"
      },
      "source": [
        "\n",
        "\n",
        "# 1. Define the sizes of the ground-truth communities\n",
        "sizes = [100, 80, 70, 50]  # Example: 4 communities of different sizes\n",
        "\n",
        "# 2. Create a probability matrix\n",
        "# Diagonal elements are intra-community probabilities, off-diagonal are inter-community probabilities\n",
        "# Example: high intra-community probability (0.3), low inter-community probability (0.01)\n",
        "probs = [\n",
        "    [0.3, 0.01, 0.01, 0.01],\n",
        "    [0.01, 0.3, 0.01, 0.01],\n",
        "    [0.01, 0.01, 0.3, 0.01],\n",
        "    [0.01, 0.01, 0.01, 0.3]\n",
        "]\n",
        "\n",
        "# 3. Generate the SBM graph\n",
        "G_sbm = nx.stochastic_block_model(sizes, probs, seed=42) # Added a seed for reproducibility\n",
        "\n",
        "print(f\"SBM graph created with {G_sbm.number_of_nodes()} nodes and {G_sbm.number_of_edges()} edges.\")\n",
        "\n",
        "# 4. Create a list of ground-truth communities\n",
        "ground_truth_communities = []\n",
        "start_node = 0\n",
        "for size in sizes:\n",
        "    community = set(range(start_node, start_node + size))\n",
        "    ground_truth_communities.append(community)\n",
        "    start_node += size\n",
        "\n",
        "print(f\"Ground-truth communities generated: {len(ground_truth_communities)} communities.\")\n",
        "# print(f\"First ground-truth community: {list(ground_truth_communities[0])[:5]}...\")"
